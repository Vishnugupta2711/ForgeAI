# Optional environment overrides for ForgeAI (copy to .env and fill as needed).
# Never commit .env or real API keys.

# Profile selector ("default" -> forge.toml, "gemini" -> forge.gemini.toml)
FORGE_PROFILE=

# Ollama (local default)
FORGE_OLLAMA_BASE_URL=http://localhost:11434

# Gemini API (read ONLY from environment / .env; never committed or logged)
FORGE_GEMINI_API_KEY=

# Generic OpenAI-compatible endpoint
FORGE_OPENAI_COMPAT_BASE_URL=
FORGE_OPENAI_API_KEY=
